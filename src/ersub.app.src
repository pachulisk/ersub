{application, ersub, [
    {description, "ErSub - Erlang/OTP + CLIPS AI API Gateway"},
    {vsn, "0.1.0"},
    {registered, [
        ersub_sup,
        ersub_config_srv
    ]},
    {mod, {ersub_app, []}},
    {applications, [
        kernel,
        stdlib,
        sasl,
        crypto,
        ssl,
        cowboy,
        gun,
        jsx,
        poolboy,
        yamerl,
        jose,
        gproc
    ]},
    %% epgsql started on-demand by ersub_repo_pool, not at boot
    {included_applications, [epgsql]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
