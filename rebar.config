{erl_opts, [
    debug_info,
    warnings_as_errors,
    {parse_transform, lager_transform}
]}.

{deps, [
    {cowboy, "2.12.0"},
    {gun, "2.1.0"},
    {jsx, "3.1.0"},
    {poolboy, "1.5.2"},
    {epgsql, "4.7.1"},
    {yamerl, "0.10.0"},
    {jose, "1.11.10"},
    {pbkdf2, "2.0.4"}
]}.

{profiles, [
    {prod, [
        {erl_opts, [no_debug_info]},
        {relx, [
            {release, {ersub, "0.1.0"}, [ersub]},
            {mode, prod},
            {sys_config, "config/sys.config"},
            {vm_args, "config/vm.args"},
            {include_erts, true},
            {extended_start_script, true}
        ]}
    ]},
    {test, [
        {deps, [
            {meck, "0.9.2"},
            {proper, "1.4.0"}
        ]},
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.

{relx, [
    {release, {ersub, "0.1.0"}, [ersub, sasl]},
    {mode, dev},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.

{shell, [
    {apps, [ersub]}
]}.

{project_plugins, [
    rebar3_proper
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls
]}.

{dialyzer, [
    {warnings, [
        unmatched_returns,
        error_handling,
        underspecs
    ]},
    {plt_extra_apps, [cowboy, gun, jsx, poolboy, epgsql]}
]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.
